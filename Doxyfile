# Doxyfile 1.11.0 最小配置（依据《代码注释规范·Doxygen》第七章）
# 生成：D:\autotools\doxygen-1.11.0\doxygen.exe Doxyfile
# 验收：退出码 0 且 doxygen_warnings.log 为 0 字节；WARN_AS_ERROR 开启后
#       任何告警都会让退出码变为 1（gen_docs.bat 据此判定失败）。

# ---- 项目信息 ----
PROJECT_NAME           = "MotionGloveSDK"
PROJECT_BRIEF          = "动捕手套数据接收、CSV 解帧与骨骼姿态输出 SDK"
PROJECT_NUMBER         = "1.0.0"
OUTPUT_DIRECTORY       = docs
OUTPUT_LANGUAGE        = Chinese
INPUT_ENCODING         = UTF-8

# ---- 输入 ----
# 注：tests 只收 tests/unit（测试代码），不收 tests/README.md——
#     INPUT 递归含子目录 README.md 时，其一级标题会与 USE_MDFILE_AS_MAINPAGE
#     冲突（found more than one \mainpage，WARN_AS_ERROR 下直接失败）。
INPUT                  = MotionGloveSDK MotionGloveSDK_examples/src MotionGloveSDK_examples/inc tests/unit docs README.md
FILE_PATTERNS          = *.h *.hpp *.c *.cpp *.cc *.dox *.md
RECURSIVE              = YES
EXCLUDE                = out build third_party docs/superpowers MotionGloveSDK/include/MOTIONGLOVE_SDK_STREAM_FORMAT.md
USE_MDFILE_AS_MAINPAGE = README.md

# ---- 提取策略 ----
EXTRACT_ALL            = NO
EXTRACT_STATIC         = YES
EXTRACT_PRIVATE        = YES
HIDE_UNDOC_MEMBERS     = NO
SOURCE_BROWSER         = YES

# ---- HTML 输出 ----
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
SEARCHENGINE           = YES
GENERATE_LATEX         = NO

# ---- 告警（规范落地的关键）----
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_LOGFILE           = doxygen_warnings.log
WARN_AS_ERROR          = YES