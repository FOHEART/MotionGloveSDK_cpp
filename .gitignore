# ── 生成物统一在 out/ 下（构建树、安装目录、压缩包）────────────────
out/
# 兼容历史遗留的根目录产物
build/
deploy/
_CPack_Packages/
*.zip
*.7z
*.rar

# ── 构建脚本自动安装的第三方依赖（VTK / micromamba）───────────────
third_party/

# ── C/C++ 编译中间产物 ──────────────────────────────────────────────
*.d
*.o
*.obj
*.slo
*.lo
*.gch
*.pch
*.ilk
*.pdb
*.dwo

# ── 库与可执行文件 ──────────────────────────────────────────────────
*.so
*.dylib
*.dll
*.a
*.la
*.lai
*.lib
*.exe
*.out
*.app

# ── 发布产物（由 release.yml / package_source 生成）─────────────────
MotionGloveSDK_example_v*.zip
MotionGloveSDK_cpp_v*.zip

# ── Doxygen 生成产物 ────────────────────────────────────────────────
# 只忽略 HTML 与告警日志；docs 下的源文件（groups.dox、设计与计划文档）需要入库
docs/html/

# ── IDE：共享配置入库，其余本机文件忽略 ────────────────────────────
# 注意顺序：必须用 .vscode/* 而不是 .vscode/，否则 ! 例外无法放行 settings.json
.vscode/*
!.vscode/settings.json
.vs/
*.user

# ── 临时文件与日志 ──────────────────────────────────────────────────
*.bak
*.tmp
*.swp
*~
*.log

# ── Agent / 工具的会话临时工作区 ────────────────────────────────────
.superpowers/
.workbuddy/

# ── 系统自动生成的文件 ──────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Python cache ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
*.egg-info/
