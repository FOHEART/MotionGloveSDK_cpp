# ── C/C++ 编译中间产物 ──────────────────────────────────────────
*.d
*.o
*.obj
*.slo
*.lo
*.gch
*.pch
*.ilk
*.pdb
*.dwo

# ── 库与可执行文件 ──────────────────────────────────────────────
*.so
*.dylib
*.dll
*.a
*.la
*.lai
*.lib
*.exe
*.out
*.app

# ── 构建输出目录 ────────────────────────────────────────────────
out/
build/

# ── Doxygen 生成产物 ────────────────────────────────────────────
# 只忽略 HTML 产物；docs 下的源文件（groups.dox、设计与计划文档）需要纳入版本控制
docs/html/

# ── IDE ────────────────────────────────────────────────────────
.vs/
.vscode/
# 但保留共享的 VSCode 设置
!.vscode/settings.json

# ── 压缩包 ──────────────────────────────────────────────────────
*.zip
*.rar

# ── 临时文件与日志 ──────────────────────────────────────────────
*.bak
*.tmp
*.swp
*~
*.log

# ── Agent / 工具的会话临时工作区 ────────────────────────────────
.superpowers/
.workbuddy/

# ── 系统自动生成的文件 ──────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Python cache ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
